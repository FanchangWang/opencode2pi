{
  "name": "opencode2pi",
  "version": "0.2.0",
  "description": "OpenCode Zen's anonymous free models (no API key) as a native omp/pi provider extension.",
  "license": "MIT",
  "author": "FanchangWang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FanchangWang/opencode2pi.git"
  },
  "keywords": [
    "omp",
    "pi",
    "pi-extension",
    "opencode",
    "opencode-zen",
    "free-models",
    "pi-package"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    }
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "smoke": "omp -e ./src/index.ts -p --model opencode-zen-free/big-pickle \"Reply with exactly OK\""
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "^18.6.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "typescript": "^5.9.0"
  }
}
